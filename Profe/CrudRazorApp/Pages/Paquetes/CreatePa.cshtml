@page
@model CrudRazorApp.Pages.Productos.CreateModel
@{
    ViewData["Title"] = "Añadir Paquete";
}

<section class="paq-form-wrap container my-4 my-md-5">
  <div class="paq-form-box bg-white">

    <h2 class="paq-form-title">Añadir Paquete</h2>

    <form>
      <div class="mb-4">
        <input type="text" class="form-control paq-input" placeholder="Peso" />
      </div>

      <div class="mb-4">
        <input type="text" class="form-control paq-input" placeholder="Contenido" />
      </div>

      <div class="mb-4">
        <input type="text" class="form-control paq-input" placeholder="Numero de Inventario" />
      </div>

            <div class="paq-btn-group text-center mt-4">
                <button type="submit" class="btn paq-btn-save">Guardar</button>
                <a asp-page="./PaIndex" class="btn paq-btn-cancel">Cancelar</a>
            </div>


    </form>

  </div>
</section>
