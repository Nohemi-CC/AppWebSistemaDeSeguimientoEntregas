@page
@model CrudRazorApp.Pages.Clientes.CreateCliModel
@{
}
<section class="paq-form-wrap container my-4 my-md-5">
    <div class="paq-form-box bg-white">

        <h2 class="paq-form-title">Añadir Cliente</h2>

        <form>
            <div class="mb-4">
                <input type="text" class="form-control paq-input" placeholder="Nombre" />
            </div>

            <div class="mb-4">
                <input type="text" class="form-control paq-input" placeholder="RFC" />
            </div>

            <div class="mb-4">
                <input type="text" class="form-control paq-input" placeholder="Email" />
            </div>

            <div class="mb-4">
                <input type="text" class="form-control paq-input" placeholder="Telefono" />
            </div>

            <div class="paq-btn-group text-center mt-4">
                <button type="submit" class="btn paq-btn-save">Guardar</button>
                <a asp-page="./Clindex" class="btn paq-btn-cancel">Cancelar</a>
            </div>
        </form>

    </div>
</section>